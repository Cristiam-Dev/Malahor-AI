{
  "name": "malahor-ai",
  "version": "0.1.1",
  "description": "CLI local para potenciar agentes de IA con memoria persistente, OpenCode, Graphify, SDD y Obsidian.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "malahor",
    "ai",
    "cli",
    "opencode",
    "mnemo",
    "graphify",
    "obsidian",
    "memory",
    "sdd",
    "agent"
  ],
  "bin": {
    "malahor-ai": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:plugin && bun build src/cli/index.ts --outdir dist --target=node && bun build src/mnemo/index.ts --outdir dist/mnemo --target=node",
    "build:plugin": "bun run scripts/build-plugin.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.assets.json",
    "test": "bun test",
    "prepack": "bun run build",
    "dev": "bun run src/cli/index.ts",
    "dev:dry-run": "bun run src/cli/index.ts install --dry-run --yes",
    "dev:sandbox": "bun run build && MALAHOR_HOME=.sandbox/home/.malahor MALAHOR_OPENCODE_DIR=.sandbox/home/.config/opencode node dist/index.js install --yes",
    "doctor:sandbox": "MALAHOR_HOME=.sandbox/home/.malahor MALAHOR_OPENCODE_DIR=.sandbox/home/.config/opencode bun run src/cli/index.ts doctor",
    "context:sandbox": "MALAHOR_HOME=.sandbox/home/.malahor MALAHOR_OPENCODE_DIR=.sandbox/home/.config/opencode bun run src/cli/index.ts context status",
    "graph:sandbox": "MALAHOR_HOME=.sandbox/home/.malahor MALAHOR_OPENCODE_DIR=.sandbox/home/.config/opencode bun run src/cli/index.ts graph --dry-run",
    "uninstall:sandbox": "MALAHOR_HOME=.sandbox/home/.malahor MALAHOR_OPENCODE_DIR=.sandbox/home/.config/opencode bun run src/cli/index.ts uninstall --yes",
    "update:sandbox": "MALAHOR_HOME=.sandbox/home/.malahor MALAHOR_OPENCODE_DIR=.sandbox/home/.config/opencode bun run src/cli/index.ts update --yes",
    "sandbox:reset": "rm -rf .sandbox"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.0.0"
}
